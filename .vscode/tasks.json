{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DPL: Install dependencies",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "install"
      ],
      "problemMatcher": []
    },
    {
      "label": "DPL: Generate database client",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "run",
        "db:generate"
      ],
      "problemMatcher": []
    },
    {
      "label": "DPL: Sync MongoDB indexes",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "run",
        "db:push"
      ],
      "problemMatcher": []
    },
    {
      "label": "DPL: First-time setup",
      "dependsOrder": "sequence",
      "dependsOn": [
        "DPL: Install dependencies"
      ],
      "problemMatcher": []
    },
    {
      "label": "DPL: Run MERN locally",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
