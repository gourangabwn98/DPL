DATABASE_URL=mongodb://127.0.0.1:27018/dpl?replicaSet=rs0
# embedded starts a local MongoDB replica set. For Atlas use external and your URI.
LOCAL_DATABASE_MODE=embedded
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
TRUST_PROXY=0
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-at-least-32-random-characters
PAYMENT_QR_PATH=/images/payment-qr.png
PAYMENT_QR_READY=false
UPI_ID=
PAYEE_NAME=
# Server-only HTTPS WhatsApp invitation. Open it and confirm the group before enabling.
WHATSAPP_INVITE_URL=
WHATSAPP_INVITE_VERIFIED=false
# Local development: local. Vercel: mongodb (payment screenshots and portraits).
STORAGE_DRIVER=local
# Used only by local storage. Do not set UPLOAD_DIR on Vercel.
UPLOAD_DIR=private-uploads
RETENTION_DAYS=180
# CLI only; unset after first-admin setup. Minimum 14 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
