DATABASE_URL=postgresql://dpl:dpl_local_only@127.0.0.1:54329/dpl?schema=public
# embedded starts local PostgreSQL automatically. external uses an existing server.
LOCAL_DATABASE_MODE=embedded
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
TRUST_PROXY=0
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-at-least-32-random-characters
PAYMENT_QR_PATH=/images/payment-qr.png
PAYMENT_QR_READY=false
UPI_ID=
PAYEE_NAME=
# Server-only HTTPS WhatsApp invitation. Open it and confirm the group before enabling.
WHATSAPP_INVITE_URL=
WHATSAPP_INVITE_VERIFIED=false
STORAGE_DRIVER=local
UPLOAD_DIR=private-uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RETENTION_DAYS=180
# CLI only; unset after first-admin setup. Minimum 14 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
