{
  "name": "dhandalsha-premier-league",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/mongo-local.mjs",
    "dev:app": "concurrently --kill-others \"tsx watch server/index.ts\" \"vite --host localhost\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:vercel": "prisma generate && prisma db push --skip-generate && npm run build",
    "test:integration": "node scripts/test-mongodb.mjs",
    "test:ui": "tsx scripts/test-ui.mjs",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "uploads:copy": "tsx scripts/copy-uploads-to-mongodb.ts",
    "admin:create": "tsx server/cli.ts admin",
    "data:purge": "tsx server/cli.ts purge",
    "test:security": "node --experimental-strip-types --test tests/security.node.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "file-type": "^21.0.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "mongodb-memory-server": "^10.4.3",
    "prisma": "6.19.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
